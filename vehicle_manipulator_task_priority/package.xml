<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vehicle_manipulator_task_priority</name>
  <version>2.0.0</version>
  <description>Task-priority control of a mobile manipulator (differential-drive base + uArm Swift Pro): pick and place
    sequenced by a behaviour tree, with ArUco detection. ROS 2 Jazzy.</description>
  <maintainer email="olipravin18@gmail.com">Pravin Oli</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>eigen</build_depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>cv_bridge</depend>
  <depend>libopencv-dev</depend>
  <depend>behaviortree_cpp</depend>
  <depend>vehicle_manipulator_task_priority_interfaces</depend>
  <exec_depend>vehicle_manipulator_task_priority_gazebo</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
