<?xml version="1.0"?>
<!-- Mobile manipulator for Gazebo Harmonic: a Kobuki-size differential-drive base (Yujin Kobuki meshes) with a deck at
     0.198 m carrying a uArm Swift Pro (UFACTORY meshes; see meshes/ATTRIBUTION.md), a forward-looking camera and a
     suction cup.

     The uArm's parallelogram is modelled as a serial chain (see swift_pro.hpp):
       waist = t1, shoulder = t2, elbow = t3 - t2, wrist_level = -t3, wrist = t4
     so the suction cup stays level as on the real arm. The controller works in t and converts.
     Collisions are simple shapes; the arm has none except the cup (links of one model do not collide). -->
<robot name="mobile_swiftpro" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="pkg" value="package://vehicle_manipulator_task_priority_gazebo"/>
  <xacro:property name="wheel_radius" value="0.035"/>
  <xacro:property name="wheel_separation" value="0.23"/>
  <xacro:property name="deck_height" value="0.198"/>
  <xacro:property name="mount_x" value="0.051"/>
  <!-- uArm geometry (swift_pro.hpp) and the 2.4 mm by which the meshes' shoulder sits lower than in the kinematics -->
  <xacro:property name="shoulder_forward" value="0.0132"/>
  <xacro:property name="shoulder_height" value="0.108"/>
  <xacro:property name="upper_arm" value="0.142"/>
  <xacro:property name="forearm" value="0.1588"/>
  <xacro:property name="bracket_forward" value="0.0565"/>
  <xacro:property name="bracket_drop" value="0.0722"/>
  <xacro:property name="mesh_dz" value="0.0024"/>

  <xacro:macro name="inertia_box" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0" iyy="${m*(x*x+z*z)/12}" iyz="0" izz="${m*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <material name="arm_grey"><color rgba="0.3 0.3 0.32 1"/></material>
  <material name="deck"><color rgba="0.15 0.15 0.15 1"/></material>

  <!-- ===================== base ===================== -->
  <link name="base_footprint"/>
  <link name="base_link">
    <visual>
      <origin xyz="0.001 0 0.05199"/>
      <geometry><mesh filename="${pkg}/meshes/kobuki/main_body.dae"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.05949"/>
      <geometry><cylinder length="0.10938" radius="0.178"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.01 0 0"/>
      <mass value="2.4"/>
      <inertia ixx="0.019995" ixy="0" ixz="0" iyy="0.019995" iyz="0" izz="0.03675"/>
    </inertial>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 0.0102"/>
  </joint>

  <xacro:macro name="wheel" params="side y">
    <link name="wheel_${side}_link">
      <visual><geometry><mesh filename="${pkg}/meshes/kobuki/wheel.dae"/></geometry></visual>
      <!-- Sphere, not cylinder: a point contact, so turning in place does not scrub the 2 cm tread (with a cylinder
           the odometry over-counted turns by 7 %). -->
      <collision><geometry><sphere radius="${wheel_radius}"/></geometry></collision>
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="6.8e-5" ixy="0" ixz="0" iyy="6.8e-5" iyz="0" izz="1.2e-4"/>
      </inertial>
    </link>
    <gazebo reference="wheel_${side}_link">
      <mu1>1.2</mu1><mu2>1.2</mu2>
      <kp>500000</kp><kd>10</kd>
      <minDepth>0.0005</minDepth>
    </gazebo>
    <joint name="wheel_${side}_joint" type="continuous">
      <parent link="base_link"/><child link="wheel_${side}_link"/>
      <origin xyz="0 ${y} 0.025" rpy="${-pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>
  <xacro:wheel side="left" y="${wheel_separation/2}"/>
  <xacro:wheel side="right" y="${-wheel_separation/2}"/>

  <!-- Frictionless casters (spheres) front and back. -->
  <xacro:macro name="caster" params="name x">
    <link name="caster_${name}_link">
      <collision><geometry><sphere radius="0.017"/></geometry></collision>
      <inertial><mass value="0.01"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
    </link>
    <joint name="caster_${name}_joint" type="fixed">
      <parent link="base_link"/><child link="caster_${name}_link"/>
      <origin xyz="${x} 0 0.0088"/>  <!-- 2 mm clear of the floor: the wheels carry the robot -->
    </joint>
    <gazebo reference="caster_${name}_link">
      <mu1>0.0</mu1><mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>
  <xacro:caster name="front" x="0.115"/>
  <xacro:caster name="back" x="-0.135"/>

  <!-- Deck carrying the arm, on four standoffs (as on a TurtleBot 2). -->
  <xacro:macro name="standoff" params="x y">
    <visual>
      <origin xyz="${x} ${y} ${-(deck_height - 0.12)/2 - 0.01}"/>
      <geometry><cylinder length="${deck_height - 0.12}" radius="0.006"/></geometry>
      <material name="arm_grey"/>
    </visual>
  </xacro:macro>
  <link name="deck_link">
    <visual>
      <origin xyz="0 0 -0.005"/>
      <geometry><cylinder length="0.01" radius="0.17"/></geometry>
      <material name="deck"/>
    </visual>
    <xacro:standoff x="0.12" y="0.10"/>
    <xacro:standoff x="0.12" y="-0.10"/>
    <xacro:standoff x="-0.12" y="0.10"/>
    <xacro:standoff x="-0.12" y="-0.10"/>
    <collision>
      <origin xyz="0 0 -0.005"/>
      <geometry><cylinder length="0.01" radius="0.17"/></geometry>
    </collision>
    <xacro:inertia_box m="0.3" x="0.3" y="0.3" z="0.01"/>
  </link>
  <joint name="deck_joint" type="fixed">
    <parent link="base_footprint"/><child link="deck_link"/>
    <origin xyz="0 0 ${deck_height}"/>
  </joint>

  <!-- ===================== arm ===================== -->
  <!-- arm_base_link is the frame A of swift_pro.hpp: on the deck, mount_x ahead of the base centre. -->
  <link name="arm_base_link">
    <visual>
      <origin xyz="0 0 ${mesh_dz}"/>
      <geometry><mesh filename="${pkg}/meshes/swiftpro/Base.STL"/></geometry>
      <material name="arm_grey"/>
    </visual>
    <xacro:inertia_box m="0.5" x="0.12" y="0.12" z="0.08"/>
  </link>
  <joint name="arm_mount" type="fixed">
    <parent link="base_footprint"/><child link="arm_base_link"/>
    <origin xyz="${mount_x} 0 ${deck_height}"/>
  </joint>

  <link name="waist_link">
    <visual>
      <origin xyz="0 0 ${mesh_dz}"/>
      <geometry><mesh filename="${pkg}/meshes/swiftpro/Link1.STL"/></geometry>
      <material name="arm_grey"/>
    </visual>
    <xacro:inertia_box m="0.2" x="0.07" y="0.14" z="0.07"/>
  </link>
  <joint name="waist" type="revolute">
    <parent link="arm_base_link"/><child link="waist_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.571" upper="1.571" effort="50" velocity="1.0"/>
    <dynamics damping="0.1"/>
  </joint>

  <link name="upper_arm_link">
    <visual>
      <origin xyz="${-shoulder_forward} 0 ${-(shoulder_height - mesh_dz)}"/>
      <geometry><mesh filename="${pkg}/meshes/swiftpro/Link2.STL"/></geometry>
      <material name="arm_grey"/>
    </visual>
    <inertial>
      <origin xyz="0 0 ${upper_arm/2}"/>
      <mass value="0.05"/>
      <inertia ixx="8.5e-5" ixy="0" ixz="0" iyy="8.5e-5" iyz="0" izz="2e-6"/>
    </inertial>
  </link>
  <joint name="shoulder" type="revolute">
    <parent link="waist_link"/><child link="upper_arm_link"/>
    <origin xyz="${shoulder_forward} 0 ${shoulder_height}"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.571" upper="0.05" effort="50" velocity="1.0"/>
    <dynamics damping="0.1"/>
  </joint>

  <link name="forearm_link">
    <visual>
      <origin xyz="${-shoulder_forward} 0 ${-(shoulder_height + upper_arm - mesh_dz)}"/>
      <geometry><mesh filename="${pkg}/meshes/swiftpro/Link3.STL"/></geometry>
      <material name="arm_grey"/>
    </visual>
    <inertial>
      <origin xyz="${forearm/2} 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="2e-6" ixy="0" ixz="0" iyy="1.1e-4" iyz="0" izz="1.1e-4"/>
    </inertial>
  </link>
  <joint name="elbow" type="revolute">
    <parent link="upper_arm_link"/><child link="forearm_link"/>
    <origin xyz="0 0 ${upper_arm}"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.621" upper="1.621" effort="50" velocity="2.0"/>
    <dynamics damping="0.1"/>
  </joint>

  <!-- Bracket kept level by wrist_level = -t3 (the parallelogram's job on the real arm). -->
  <link name="bracket_link">
    <xacro:inertia_box m="0.02" x="0.06" y="0.03" z="0.08"/>
  </link>
  <joint name="wrist_level" type="revolute">
    <parent link="forearm_link"/><child link="bracket_link"/>
    <origin xyz="${forearm} 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-0.05" upper="1.571" effort="50" velocity="2.0"/>
    <dynamics damping="0.05"/>
  </joint>

  <!-- suction_cup: the end-effector frame of swift_pro.hpp, at the tip of the cup. -->
  <link name="suction_cup">
    <visual>
      <origin xyz="${-(shoulder_forward + forearm + bracket_forward)} 0 ${-(shoulder_height + upper_arm - bracket_drop - mesh_dz)}"/>
      <geometry><mesh filename="${pkg}/meshes/swiftpro/Suction.STL"/></geometry>
      <material name="arm_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.004"/>
      <geometry><cylinder length="0.008" radius="0.008"/></geometry>
    </collision>
    <xacro:inertia_box m="0.02" x="0.02" y="0.02" z="0.02"/>
  </link>
  <joint name="wrist" type="revolute">
    <parent link="bracket_link"/><child link="suction_cup"/>
    <origin xyz="${bracket_forward} 0 ${-bracket_drop}"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.571" upper="1.571" effort="10" velocity="2.0"/>
    <dynamics damping="0.02"/>
  </joint>

  <!-- ===================== camera ===================== -->
  <link name="camera_link">
    <visual><geometry><box size="0.025 0.09 0.025"/></geometry><material name="deck"/></visual>
    <xacro:inertia_box m="0.05" x="0.025" y="0.09" z="0.025"/>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_footprint"/><child link="camera_link"/>
    <origin xyz="0.15 0 0.215" rpy="0 0.35 0"/>
  </joint>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/><child link="camera_optical_frame"/>
    <origin rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>
  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <topic>/camera/image</topic>
      <camera>
        <camera_info_topic>/camera/camera_info</camera_info_topic>
        <optical_frame_id>camera_optical_frame</optical_frame_id>
        <horizontal_fov>1.047</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.03</near><far>8</far></clip>
        <noise><type>gaussian</type><mean>0</mean><stddev>0.005</stddev></noise>
      </camera>
    </sensor>
  </gazebo>

  <!-- ===================== Gazebo systems ===================== -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
    <!-- Ground truth for evaluation only (the controller uses /odom). -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>/ground_truth/odometry</odom_topic>
      <tf_topic>/ground_truth/tf</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
    <!-- Arm joints are velocity-commanded, one topic each (gz.msgs.Double). -->
    <xacro:macro name="velocity_joint" params="joint">
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>${joint}</joint_name>
        <topic>/arm/${joint}/cmd_vel</topic>
        <initial_velocity>0.0</initial_velocity>
      </plugin>
    </xacro:macro>
    <xacro:velocity_joint joint="waist"/>
    <xacro:velocity_joint joint="shoulder"/>
    <xacro:velocity_joint joint="elbow"/>
    <xacro:velocity_joint joint="wrist_level"/>
    <xacro:velocity_joint joint="wrist"/>
    <!-- Suction: a fixed joint between the cup and the box, created and removed on demand. It exists at start-up,
         so the launch file detaches it once. -->
    <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
      <parent_link>suction_cup</parent_link>
      <child_model>aruco_box</child_model>
      <child_link>link</child_link>
      <attach_topic>/suction/attach</attach_topic>
      <detach_topic>/suction/detach</detach_topic>
      <output_topic>/suction/state</output_topic>
    </plugin>
  </gazebo>
</robot>
