<?xml version="1.0"?>
<!-- Pick-and-place world: a box with ArUco markers on a 0.08 m stand at (1.2, 0.4), and an empty stand at (-0.3, 1.2)
     where it is to be placed. The robot starts at the origin facing +x. Surfaces are at 0.08 m, the box top at 0.15 m. -->
<sdf version="1.9">
  <world name="pick_place">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><diffuse>0.55 0.55 0.5 1</diffuse><ambient>0.55 0.55 0.5 1</ambient></material></visual>
      </link>
    </model>

    <model name="pick_stand">
      <static>true</static>
      <pose>1.2 0.4 0.04 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 0.12 0.08</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 0.12 0.08</size></box></geometry>
          <material><diffuse>0.35 0.45 0.7 1</diffuse><ambient>0.35 0.45 0.7 1</ambient></material></visual>
      </link>
    </model>

    <model name="place_stand">
      <static>true</static>
      <pose>-0.3 1.2 0.04 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 0.12 0.08</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 0.12 0.08</size></box></geometry>
          <material><diffuse>0.7 0.45 0.3 1</diffuse><ambient>0.7 0.45 0.3 1</ambient></material></visual>
      </link>
    </model>

    <include>
      <uri>model://aruco_box</uri>
      <name>aruco_box</name>
      <pose>1.2 0.4 0.115 0 0 0.3</pose>
    </include>
  </world>
</sdf>
