<?xml version="1.0"?>
<package format="2">
  <name>mobile_manipulator_tp</name>
  <version>0.1.0</version>
  <description>
    Task-priority kinematic control of a mobile manipulator (Kobuki TurtleBot 2
    with a uArm Swift Pro) for pick, transport and place, sequenced with
    behaviour trees and localised by dead reckoning or ArUco markers.
  </description>

  <!-- TODO: replace with a public contact address for the maintainer. -->
  <maintainer email="maintainer@example.com">Pravin Oli</maintainer>
  <author>Pravin Oli</author>
  <author>Gebrecherkos G.</author>

  <license>Apache-2.0</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>message_generation</build_depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>message_runtime</exec_depend>

  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>py_trees</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
</package>
